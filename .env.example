# Copy to .env (gitignored) and fill in for a deployment. docker compose reads it.
# Locally you can skip this entirely — the compose file has dev defaults.

POSTGRES_USER=vocabio
# Use a long random value on any public server, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me-to-a-strong-secret
POSTGRES_DB=vocabio

# Public origin the browser will use. On EC2: http://<your-ec2-public-ip>
CORS_ORIGINS=http://localhost:8080
